	<description>COM_JCBINOUT_XML_DESCRIPTION</description>
	<namespace path="src">Yepr\Component\Jcbinout</namespace>

	<administration>
		<menu link="option=com_jcbinout">COM_JCBINOUT</menu>

		<!--
			The folder mirrors where these files end up, because the package
			mirrors the install path: everything under src/ in the repository is
			laid out exactly as Joomla lays it out on disk.
		-->
		<files folder="administrator/components/com_jcbinout">
			<folder>data</folder>
			<folder>language</folder>
			<folder>services</folder>
			<folder>src</folder>
			<folder>tmpl</folder>
		</files>
	</administration>
