includes:
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon

parameters:
    # Level 5 is where findings are about whether the code works. The docblock
    # levels above it are mostly "array of what?" on code that predates the
    # analyser being pointed at it.
    level: 5

    paths:
        - src/administrator/components/com_jcbinout/src
        - build
        - tools
        - tests

    # Joomla is reference material: it supplies the base classes the component
    # extends and the constants it reads. Without it every `extends
    # BaseDatabaseModel` is an unknown class and the analysis says nothing.
    # /joomla is git-ignored; `composer joomla` fetches it, and CI does the same.
    #
    # JCB is scanned for the same reason: the extractor reflects over its
    # classes, so their signatures have to resolve.
    #
    # From vendor-jcb rather than from the site, because that is the copy that
    # exists everywhere. A development machine has JCB installed under /joomla
    # and a runner does not, so pointing only at the site resolved these
    # classes here and left CI reporting `VDM\Joomla\Componentbuilder\Table`
    # unknown - the analysis passing locally and failing there, which is the
    # one way a static gate is worse than no gate. `tools/cli.php fetch`
    # populates it, and CI runs that before this.
    scanDirectories:
        - joomla/libraries
        - joomla/administrator/components
        - vendor-jcb

    # Joomla defines these when an application boots, so they exist at runtime
    # and in no file an analyser reads.
    bootstrapFiles:
        - tools/phpstan-bootstrap.php

    treatPhpDocTypesAsCertain: false
